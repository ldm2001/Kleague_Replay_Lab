{
  "name": "replay-lab",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @replay/web -- --port 3100",
    "dev:worker": "node --env-file-if-exists=apps/web/.env.local scripts/worker.mjs",
    "dev:worker:validate": "node --env-file-if-exists=apps/web/.env.local scripts/worker.mjs validate",
    "dev:worker:analyze": "node --env-file-if-exists=apps/web/.env.local scripts/worker.mjs analyze",
    "dev:infra": "docker compose -f infra/local/docker-compose.yml up -d",
    "test": "vitest run",
    "audit:incidents": "vite-node --config vitest.config.ts scripts/incidents.ts",
    "test:video": "node scripts/tests.mjs -c apps/video-worker/pyproject.toml apps/video-worker/tests -q",
    "test:perception": "experiments/perception/.venv-referee/bin/python -m pytest -c packages/perception/pyproject.toml packages/perception/tests -q",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "check:enums": "node scripts/check/enums.mjs",
    "check:edition": "node scripts/check/edition.mjs",
    "check:facts": "node scripts/check/facts.mjs",
    "db:migrate": "node scripts/database/migration.mjs",
    "db:explain": "node scripts/database/plan.mjs",
    "db:stats": "node scripts/database/stats.mjs",
    "check": "npm run typecheck && npm run check:edition && npm run check:enums && npm run check:facts && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  }
}
