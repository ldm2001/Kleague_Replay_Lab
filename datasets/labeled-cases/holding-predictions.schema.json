{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "개발용 잡기 사실 단위 방법 예측",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "producer", "predictions"],
    "properties": {
        "schemaVersion": {"const": "holding-predictions-v1"},
        "producer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
                "id": {"$ref": "#/$defs/identifier"},
                "version": {"$ref": "#/$defs/identifier"}
            }
        },
        "predictions": {"type": "array", "items": {"$ref": "#/$defs/prediction"}}
    },
    "$defs": {
        "identifier": {"type": "string", "minLength": 1, "pattern": "^\\S(?:[\\s\\S]*\\S)?$", "not": {"pattern": "\\s$"}},
        "hash": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$"},
        "state": {"enum": ["CONFIRMED", "REFUTED", "UNKNOWN"]},
        "time": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "fact": {
            "enum": [
                "observations.actionObserved", "observations.directionObserved",
                "observations.bodyOrEquipmentContact", "observations.gripMaintained",
                "observations.pulling", "observations.movementImpeded"
            ]
        },
        "prediction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "sourceSha256", "eventId", "actorId", "targetId",
                "startMs", "endMs", "factKey", "predicted"
            ],
            "properties": {
                "sourceSha256": {"$ref": "#/$defs/hash"},
                "eventId": {"$ref": "#/$defs/identifier"},
                "actorId": {"$ref": "#/$defs/identifier"},
                "targetId": {"$ref": "#/$defs/identifier"},
                "startMs": {"$ref": "#/$defs/time"},
                "endMs": {"$ref": "#/$defs/time"},
                "factKey": {"$ref": "#/$defs/fact"},
                "predicted": {"$ref": "#/$defs/state"}
            },
            "$comment": "경기 ID와 분할과 출처는 정답이 소유하므로 예측에 두지 않고 추가 실행 검사에서 정답에 없는 예측과 동일 명제 중복 거부"
        }
    }
}
