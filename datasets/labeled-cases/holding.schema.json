{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "개발용 잡기 사실 단위 평가 입력",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "producer", "cases"],
    "properties": {
        "schemaVersion": {"const": "holding-validation-v1"},
        "producer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
                "id": {"$ref": "#/$defs/identifier"},
                "version": {"$ref": "#/$defs/identifier"}
            }
        },
        "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}}
    },
    "$defs": {
        "identifier": {"type": "string", "minLength": 1, "pattern": "^\\S(?:[\\s\\S]*\\S)?$", "not": {"pattern": "\\s$"}},
        "hash": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$"},
        "state": {"enum": ["CONFIRMED", "REFUTED", "UNKNOWN"]},
        "time": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "case": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id", "sourceSha256", "matchId", "eventId", "split", "actorId",
                "targetId", "startMs", "endMs", "factKey", "expected", "predicted", "provenance"
            ],
            "properties": {
                "id": {"$ref": "#/$defs/identifier"},
                "sourceSha256": {"$ref": "#/$defs/hash"},
                "matchId": {"$ref": "#/$defs/identifier"},
                "eventId": {"$ref": "#/$defs/identifier"},
                "split": {"enum": ["DEVELOPMENT", "EVALUATION"]},
                "actorId": {"$ref": "#/$defs/identifier"},
                "targetId": {"$ref": "#/$defs/identifier"},
                "startMs": {"$ref": "#/$defs/time"},
                "endMs": {"$ref": "#/$defs/time"},
                "factKey": {
                    "enum": ["actionType", "direction", "bodyOrEquipmentContact", "gripMaintained", "pulling", "movementImpeded"]
                },
                "expected": {"$ref": "#/$defs/state"},
                "predicted": {"$ref": "#/$defs/state"},
                "provenance": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["origin", "reviewer", "evidenceSha256"],
                    "properties": {
                        "origin": {"const": "DEVELOPMENT_REVIEW"},
                        "reviewer": {"$ref": "#/$defs/identifier"},
                        "evidenceSha256": {"$ref": "#/$defs/hash"}
                    }
                }
            },
            "$comment": "추가 실행 검사에서 정수 토큰과 endMs > startMs와 actorId != targetId 및 사례 ID와 동일 명제 중복과 원본 경기 사건의 분할 누수 확인"
        }
    }
}
