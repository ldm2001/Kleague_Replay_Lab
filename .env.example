# PostgreSQL — 분석 상태 · 사실 Revision · 규정 메타데이터 · 판정 결과
DATABASE_URL=postgresql://replay:replay@127.0.0.1:5432/replay_lab

# S3 호환 Private Object Storage — 원본 영상 · 증거 프레임 · 짧은 클립
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=replay-lab
STORAGE_ACCESS_KEY_ID=replay
STORAGE_SECRET_ACCESS_KEY=replay-secret

# Nextjs 내부 Worker API — 작업 선점과 결과 수신의 호출자 인증
# apps/web/src/apis/job.ts 가 검사
WORKER_AUTH_TOKEN=local-worker-token
WORKER_LEASE_MS=300000

# Python 영상 Worker가 내부 Worker API를 호출할 주소
INTERNAL_API_BASE_URL=http://127.0.0.1:3100

# Redis — Rate Limit과 다중 인스턴스 공유 캐시와 Queue가 실제로 필요할 때만 채운다
# 비어 있으면 PostgreSQL Job Table 선점 방식으로 동작한다
REDIS_URL=
