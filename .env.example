# 값은 비워 둔다. 실제 값은 .env(로컬) 또는 배포 서비스의 Secret에 넣는다.
# 각 항목은 README 5절의 확정 스택에서 나온 것이고, 임의로 추가하지 않는다.

# PostgreSQL — 분석 상태 · 사실 Revision · 규정 메타데이터 · 판정 결과
DATABASE_URL=

# S3 호환 Private Object Storage — 원본 영상 · 증거 프레임 · 짧은 클립
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Nextjs 내부 Worker API — 작업 선점과 결과 수신의 호출자 인증
# web/src/adapters/worker-auth 가 검사한다
WORKER_AUTH_TOKEN=

# Python 영상 Worker가 내부 Worker API를 호출할 주소
INTERNAL_API_BASE_URL=

# Redis — Rate Limit과 다중 인스턴스 공유 캐시와 Queue가 실제로 필요할 때만 채운다.
# 비어 있으면 PostgreSQL Job Table 선점 방식으로 동작한다 (README 5절).
REDIS_URL=
DATABASE_URL=postgresql://replay:replay@localhost:5432/replay_lab
