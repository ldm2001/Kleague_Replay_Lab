{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@replay/application": ["./apps/web/src/application/index.ts"],
      "@replay/database": ["./apps/web/src/database/index.ts"],
      "@replay/adapters": ["./apps/web/src/adapters/index.ts"],
      "@replay/shared-types": ["./apps/web/src/shared/index.ts"],
      "@replay/rule-data": ["./apps/web/src/rules/data/index.ts"],
      "@replay/rule-engine": ["./apps/web/src/rules/engine/index.ts"]
    }
  },
  "include": ["apps/web/next-env.d.ts", "apps/web/src/**/*.ts", "apps/web/src/**/*.tsx", "apps/web/test/**/*.ts", "apps/web/test/**/*.tsx", "vitest.config.ts"]
}
