{
  "suite": "push-decision",
  "fixture_schema_version": 2,
  "description": "밀기 판정과 세 개의 게이트(각도·속도·강도). 실제 경기와 무관한 최소 입력만 씁니다.",
  "assertion_mode": "STRICT",
  "cases": [
    {
      "id": "push-01-camera-gate-overrides-everything",
      "concern": "각도 게이트",
      "given": {
        "rule_version": "2025-26",
        "facts": {
          "camera_sufficiency": "low",
          "contact_detected": {
            "value": true,
            "observed_at_speed": "NORMAL"
          },
          "severity": {
            "value": "EXCESSIVE_FORCE",
            "observed_at_speed": "NORMAL"
          },
          "opponent_displacement": {
            "value": "clear",
            "observed_at_speed": "NORMAL"
          },
          "inside_penalty_area": {
            "value": true,
            "observed_at_speed": "NORMAL"
          }
        }
      },
      "expect": {
        "decision": "INCONCLUSIVE",
        "inconclusive_reason": "CAMERA_INSUFFICIENT",
        "citations_min": 1
      },
      "note": "다른 모든 값이 퇴장까지 확정적인데도 각도 게이트가 전부 덮어야 합니다. 게이트가 마지막이 아니라 첫 분기라는 것을 고정합니다."
    },
    {
      "id": "push-02-no-contact",
      "concern": "기본 분기",
      "given": {
        "rule_version": "2025-26",
        "facts": {
          "camera_sufficiency": "high",
          "contact_detected": {
            "value": false,
            "observed_at_speed": "NORMAL"
          }
        }
      },
      "expect": {
        "decision": "NO_FOUL",
        "restart_type": "NONE",
        "citations_min": 1
      },
      "note": "접촉이 없으면 강도를 볼 필요가 없습니다. 속도 게이트보다 앞에 있어야 합니다."
    },
    {
      "id": "push-03-severity-slow-only",
      "concern": "속도 게이트",
      "given": {
        "rule_version": "2025-26",
        "facts": {
          "camera_sufficiency": "high",
          "contact_detected": {
            "value": true,
            "observed_at_speed": "NORMAL"
          },
          "severity": {
            "value": "RECKLESS",
            "observed_at_speed": "SLOW"
          },
          "opponent_displacement": {
            "value": "clear",
            "observed_at_speed": "SLOW"
          },
          "inside_penalty_area": {
            "value": false,
            "observed_at_speed": "NORMAL"
          }
        }
      },
      "expect": {
        "decision": "INCONCLUSIVE",
        "inconclusive_reason": "SLOW_MOTION_ONLY",
        "citations_min": 1
      },
      "note": "severity 값 자체는 RECKLESS로 확정돼 있습니다. 그래도 막혀야 합니다. 값이 아니라 관측 조건이 게이트라는 것을 고정합니다."
    },
    {
      "id": "push-04-severity-uncertain-at-normal-speed",
      "concern": "속도 게이트와 강도 게이트의 사유 구분",
      "given": {
        "rule_version": "2025-26",
        "facts": {
          "camera_sufficiency": "high",
          "contact_detected": {
            "value": true,
            "observed_at_speed": "NORMAL"
          },
          "severity": {
            "value": "uncertain",
            "observed_at_speed": "NORMAL"
          },
          "opponent_displacement": {
            "value": "clear",
            "observed_at_speed": "NORMAL"
          },
          "inside_penalty_area": {
            "value": false,
            "observed_at_speed": "NORMAL"
          }
        }
      },
      "expect": {
        "decision": "INCONCLUSIVE",
        "inconclusive_reason": "SEVERITY_UNDETERMINED",
        "citations_min": 1
      },
      "note": "03과 결과는 같고 사유가 달라야 합니다. 정상 속도로 봤는데 못 정한 것과 아예 정상 속도로 못 본 것은 다음에 할 일이 다릅니다."
    },
    {
      "id": "push-05-possible-displacement-is-not-foul",
      "concern": "보류 ≠ 파울",
      "given": {
        "rule_version": "2025-26",
        "facts": {
          "camera_sufficiency": "high",
          "contact_detected": {
            "value": true,
            "observed_at_speed": "NORMAL"
          },
          "severity": {
            "value": "CARELESS",
            "observed_at_speed": "NORMAL"
          },
          "opponent_displacement": {
            "value": "possible",
            "observed_at_speed": "NORMAL"
          },
          "inside_penalty_area": {
            "value": false,
            "observed_at_speed": "NORMAL"
          }
        }
      },
      "expect": {
        "decision": "INCONCLUSIVE",
        "inconclusive_reason": "SEVERITY_UNDETERMINED",
        "citations_min": 1
      },
      "note": "`possible`을 파울 쪽으로 반올림하지 않습니다. 애매한 것은 애매하다고 답합니다."
    },
    {
      "id": "push-06-careless-without-displacement",
      "concern": "정상 접촉",
      "given": {
        "rule_version": "2025-26",
        "facts": {
          "camera_sufficiency": "high",
          "contact_detected": {
            "value": true,
            "observed_at_speed": "NORMAL"
          },
          "severity": {
            "value": "CARELESS",
            "observed_at_speed": "NORMAL"
          },
          "opponent_displacement": {
            "value": "none",
            "observed_at_speed": "NORMAL"
          },
          "inside_penalty_area": {
            "value": false,
            "observed_at_speed": "NORMAL"
          }
        }
      },
      "expect": {
        "decision": "NORMAL_CONTACT",
        "restart_type": "NONE",
        "citations_min": 1
      },
      "note": "접촉이 있어도 파울이 아닐 수 있습니다. 접촉=파울로 붕괴하면 이 케이스가 깨집니다."
    },
    {
      "id": "push-07-reckless-inside-penalty-area",
      "concern": "Law 12 강도 3분법",
      "given": {
        "rule_version": "2025-26",
        "facts": {
          "camera_sufficiency": "high",
          "contact_detected": {
            "value": true,
            "observed_at_speed": "NORMAL"
          },
          "severity": {
            "value": "RECKLESS",
            "observed_at_speed": "NORMAL"
          },
          "opponent_displacement": {
            "value": "clear",
            "observed_at_speed": "NORMAL"
          },
          "inside_penalty_area": {
            "value": true,
            "observed_at_speed": "NORMAL"
          }
        }
      },
      "expect": {
        "decision": "FOUL",
        "severity": "RECKLESS",
        "restart_type": "PENALTY_KICK",
        "disciplinary_action": "CAUTION",
        "citations_min": 1
      }
    },
    {
      "id": "push-08-excessive-force-outside-penalty-area",
      "concern": "Law 12 강도 3분법",
      "given": {
        "rule_version": "2025-26",
        "facts": {
          "camera_sufficiency": "high",
          "contact_detected": {
            "value": true,
            "observed_at_speed": "NORMAL"
          },
          "severity": {
            "value": "EXCESSIVE_FORCE",
            "observed_at_speed": "NORMAL"
          },
          "opponent_displacement": {
            "value": "clear",
            "observed_at_speed": "NORMAL"
          },
          "inside_penalty_area": {
            "value": false,
            "observed_at_speed": "NORMAL"
          }
        }
      },
      "expect": {
        "decision": "FOUL",
        "severity": "EXCESSIVE_FORCE",
        "restart_type": "DIRECT_FREE_KICK",
        "disciplinary_action": "SEND_OFF",
        "citations_min": 1
      },
      "note": "CARELESS는 징계 없음, RECKLESS는 경고, EXCESSIVE_FORCE는 퇴장. 세 등급이 각각 다른 징계로 이어지는지를 07과 함께 고정합니다."
    }
  ],
  "invariants": [
    {
      "id": "push-09-every-result-carries-a-citation",
      "concern": "추적성",
      "applies_to": "이 스위트의 모든 케이스",
      "expect": {
        "citations_min": 1
      },
      "note": "보류든 파울이든 결과에는 반드시 조항이 붙습니다. 조항 없는 결론은 이 시스템의 산출물이 아닙니다."
    },
    {
      "id": "push-10-regulation-account-survives-a-blocked-fact",
      "concern": "산출물 형태",
      "applies_to": "이 스위트의 모든 케이스",
      "expect": {
        "accounts_non_empty": true,
        "blocked_facts_reported": true
      },
      "note": "사실값이 확인되지 않아도 accounts는 비어 있을 수 없습니다. 규정이 무엇을 요구하는지는 영상과 무관하게 말할 수 있기 때문입니다. 막힌 사실은 blocked_from에 나오고, 그때도 규정 설명은 그대로 나와야 합니다. INCONCLUSIVE가 빈 화면이 되면 이 검사가 막습니다"
    }
  ]
}
