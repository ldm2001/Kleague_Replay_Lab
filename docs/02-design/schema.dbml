// Replay_Lab 데이터 모델
// 출처: README 8절 (데이터 모델 초안) · 12절 (구단 데이터)
// VS Code DBML Canvas에서 렌더링하는 설계 원본
//
// 표기 규율 (README 2절 근거 규율)
//   [확인]  README 8절에 열이나 값이 그대로 적혀 있음
//   [추론]  README 다른 절의 서술에서 끌어냄 · 근거 절을 함께 적음
//   [미정]  README가 말하지 않음 · 채우지 않고 질문으로 남김
//
// 1단계(규정 데이터와 Rule Engine)는 DB를 만들지 않음.
// 이 파일은 2단계 마이그레이션의 대상이자, 1단계 shared-types 가
// 맞춰야 할 저장 계약임 (README 8절 decision_results).

Project replay_lab {
  database_type: 'PostgreSQL'
  Note: '''
  K리그 영상 기반 판정 분석. 결론이 아니라 규정이 무엇을 요구하는지를 산출한다.

  전역 제약
  - 심판 개인 식별 정보는 어떤 열에도 저장하지 않는다 (official_verdicts.quote 포함).
  - 규정 원문 전문을 저장하지 않는다. 조항 단위 인용과 출처만 저장한다.
  - 영상 바이트는 DB에 없다. Private Object Storage 에 있고 DB 는 참조만 갖는다.
  - decision_results 와 fact_revisions 의 행은 갱신하지 않는다. 새 행을 추가한다.
  - Object Storage 삭제는 DB 트랜잭션 밖에서 실행한다. DB 는 상태 전이와 ProcessingJob 생성만 원자적으로 처리한다.

  삭제 정책
  - 원본과 증거 바이트는 object_deleted_at 으로 삭제 완료를 기록하고 TTL 전까지 메타데이터 행을 유지한다.
  - PURGE_ANALYSIS 는 Object Storage 삭제 확인 뒤 Analysis child 행과 Analysis 를 지운다.
  - 연결된 video_assets 행은 Analysis 삭제 뒤 마지막에 지운다.
  - FK 의 DELETE 동작은 마이그레이션에서 명시한다. DBML Ref 는 관계와 복합 무결성만 표현한다.
  '''
}


// ─────────────────────────────────────────────────────────────
// 열거형 — README 8절에 적힌 값만 옮김
// ─────────────────────────────────────────────────────────────

enum video_asset_status {
  CREATED
  UPLOADING
  VALIDATING
  VALID
  REJECTED
  EXPIRED
  DELETED
}

enum retention_class {
  TEMPORARY [note: '공개 API가 만드는 분석은 항상 이 값. 24시간 TTL']
  CURATED   [note: '배포 권한이 있는 CLI 적재 전용. 사용자 업로드를 자동 전환하지 않음']
}

enum job_type {
  VALIDATE_VIDEO     [note: 'video_asset_id 만 요구']
  ANALYZE_VIDEO      [note: 'analysis_id 만 요구']
  DELETE_VIDEO_ASSET [note: 'video_asset_id 만 요구']
  PURGE_ANALYSIS     [note: 'analysis_id 만 요구']
}

enum job_status {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum idempotency_operation {
  CREATE_ANALYSIS
  PATCH_FACTS
}

enum review_scenario {
  GOAL_DISALLOWED      [note: '득점이 취소됨']
  GOAL_AWARDED         [note: '득점이 인정됨']
  PENALTY_NOT_GIVEN    [note: 'PK가 선언되지 않음']
  PENALTY_GIVEN        [note: 'PK가 선언됨']
  SENDING_OFF_NOT_GIVEN [note: '퇴장이 주어지지 않음']
  CARD_SHOWN           [note: '카드가 제시됨']
  SECOND_CAUTION       [note: '2차 경고로 인한 퇴장']
  CORNER_KICK_AWARDED  [note: '코너킥이 선언됨']
  OTHER                [note: '버리는 값이 아님. 엔진이 OUT_OF_SCOPE 를 반환하는 입구']
}

enum camera_sufficiency {
  LOW
  MEDIUM
  HIGH
}

enum candidate_review_status {
  UNREVIEWED
  CONFIRMED
  DISMISSED
}

enum playback_speed {
  NORMAL
  SLOW
  UNKNOWN
}

enum fact_source {
  MODEL
  USER
  CURATOR
}

enum evidence_kind {
  FRAME
  CLIP
}

enum observed_restart_type {
  DIRECT_FREE_KICK
  INDIRECT_FREE_KICK
  FREE_KICK_UNSPECIFIED [note: '프리킥인 건 확인됐으나 직접·간접 구분이 확인되지 않음. 임의로 채우지 않는다']
  PENALTY_KICK
  DROP_BALL
  THROW_IN
  GOAL_KICK
  CORNER_KICK
  KICK_OFF
  PLAY_CONTINUED [note: '재개 없이 속행 — 반칙 없음으로 처리됨']
  UNKNOWN
}

enum observed_restart_beneficiary {
  ATTACKING_TEAM
  DEFENDING_TEAM
  NONE
  UNKNOWN
}

enum observed_goal_decision {
  GOAL
  NO_GOAL
  NOT_APPLICABLE
  UNKNOWN
}

enum observed_source {
  RESTART_INFERRED [note: '재개 방식에서 역산']
  REFEREE_SIGNAL
  VAR_OFR
  USER_INPUT
  MATCH_REPORT
}

enum decision_match {
  MATCH
  MISMATCH [note: '오심 확정값이 아님. 관측과 규정 적용 결과가 다르다는 뜻']
  UNDETERMINED
}

enum severity {
  CARELESS       [note: '징계 없음']
  RECKLESS       [note: '경고']
  EXCESSIVE_FORCE [note: '퇴장']
}

// ── VAR 네 게이트 ──────────────────────────────────────────
// 범주 → 시한 → 문턱 → 절차. 네 값을 하나로 접지 않는다.
// var_reviewable=true 와 var_intervention=NO_INTERVENTION 이 동시에 성립해야 한다.

enum var_category {
  GOAL_NO_GOAL
  PENALTY_NO_PENALTY
  RED_CARD
  MISTAKEN_IDENTITY
  CORNER_KICK [note: '2026/27 신설 + competition option']
  NONE
}

enum var_threshold_result {
  MET
  NOT_MET
  UNDETERMINED [note: '불리언이 아닌 이유: 강도가 속도 게이트에 걸리면 이 값이 정직하다']
}

enum var_intervention {
  NO_INTERVENTION
  OVERTURNED
  CONFIRMED
}

enum var_no_intervention_reason {
  NOT_REVIEWABLE    [note: '범주 게이트']
  TOO_LATE          [note: '시한 게이트']
  THRESHOLD_NOT_MET [note: '문턱 게이트']
}

enum var_not_reviewable_reason {
  OUTSIDE_REVIEWABLE_CATEGORIES [note: '판본에 그 범주가 없음']
  COMPETITION_OPTION_NOT_ADOPTED [note: '판본엔 있으나 대회가 채택 안 함']
}

enum var_window_closed_reason {
  PLAY_RESTARTED [note: '검토 창을 닫는 유일한 조건. 원심 선언은 차단 조건이 아니다']
}

// [확인] IFAB VAR 프로토콜 1.10 / Law 5.3 원문이 다섯을 든다
//        "mistaken identity or ... violent conduct, spitting, biting or
//         extremely offensive, insulting and/or abusive action(s)"
//        README 8절 초안의 MISTAKEN_IDENTITY|VIOLENT_CONDUCT 두 값으로는
//        "침 뱉기로 재개 후 퇴장"을 표현할 수 없어 원문이 나눈 만큼으로 넓혔다.
//        send_off_category와 값을 맞춰 두어 변환표가 필요 없다.
enum var_window_exception {
  MISTAKEN_IDENTITY
  VIOLENT_CONDUCT
  BITING_OR_SPITTING
  OFFENSIVE_LANGUAGE_OR_ACTION
  NONE
}

// [확인] IFAB Law 12.3 「Sending-off offences」 2025/26 p.117 아홉 항목을
//        판정에 필요한 만큼 묶은 것. DOGSO 세 항목은 퇴장 사유로는 하나이고,
//        biting/spitting은 원문이 한 항목으로 적었다.
//        열이 아니라 fact_revisions.facts 안의 값이다.
enum send_off_category {
  DOGSO
  SERIOUS_FOUL_PLAY
  BITING_OR_SPITTING
  VIOLENT_CONDUCT
  OFFENSIVE_LANGUAGE_OR_ACTION
  SECOND_CAUTION
  ENTERING_VOR
  NONE [note: '퇴장 사안이 아님']
}

// [확인] observed_card 와 disciplinary_action 이 함께 쓴다.
//        엔진은 SECOND_CAUTION 을 내지 않는다 — 이 사건 하나만 보고는
//        해당 선수가 이미 경고를 받았는지 알 수 없다. 관측 쪽에서만 들어온다.
enum disciplinary_action {
  NONE
  CAUTION
  SECOND_CAUTION
  SEND_OFF
}

// [확인] README 11절 Decision. foul_decision 이 이 어휘를 쓴다.
enum foul_decision {
  FOUL
  NO_FOUL
  NORMAL_CONTACT
  INCONCLUSIVE [note: '영상 근거 부족 — 더 나은 영상이 있으면 답이 나온다']
  OUT_OF_SCOPE [note: '규정에 조문 없음 — 영상을 아무리 봐도 답이 없다']
}

enum var_review_procedure {
  OFR      [note: '주관적 판정']
  VAR_ONLY [note: '사실적 판정']
  NONE
}

enum inconclusive_reason {
  CAMERA_INSUFFICIENT   [note: '각도 부족']
  SEVERITY_UNDETERMINED [note: '강도 특정 불가']
  SLOW_MOTION_ONLY      [note: '정상 속도 관측 없음 — 속도 게이트']
  OUT_OF_SCOPE          [note: '규정에 조문 없음. 영상이 부족한 게 아니다']
}

enum announced_by {
  KFA_REFEREE_COMMITTEE
  COMPETITION_ORGANISER
  OTHER
}

enum official_verdict_value {
  CORRECT
  INCORRECT
  NO_COMMENT
}

enum official_verdict_status {
  EXTERNAL_OPINION [note: '공식 발표와 시스템 판정을 별도로 표시. 어느 쪽도 자동 정답이 아님']
}

// ── fact_revisions.facts JSONB 안의 값 ────────────────────
// 열이 아니라 JSONB 내부 값이지만, 게이트가 읽으므로 여기에 함께 고정한다.

enum contact_type {
  PUSHING
  CHARGING
  HANDBALL
  TACKLE
  OTHER
}

enum disallow_reason {
  ATTACKING_TEAM_FOUL
  OFFSIDE
  BALL_OUT_OF_PLAY
  OTHER
}

enum referee_decision_type {
  NO_FOUL
  FOUL_AGAINST_ATTACKER
  FOUL_AGAINST_DEFENDER
  PLAY_ON
  UNKNOWN [note: '이 값이 UNKNOWN 이 아니라는 사실이 VAR 검토의 전제. 어떤 값도 var_reviewable 을 false 로 만들지 않는다']
}

enum decision_nature {
  FACTUAL
  SUBJECTIVE
}

enum error_magnitude {
  CLEAR_AND_OBVIOUS
  NOT_CLEAR_AND_OBVIOUS
  UNDETERMINED
}


// ─────────────────────────────────────────────────────────────
// 세션과 업로드
// ─────────────────────────────────────────────────────────────

Table anonymous_sessions {
  id uuid [pk]
  token_hash bytea [not null, unique, note: '원문 토큰은 저장하지 않음. 브라우저에는 Secure·HttpOnly·SameSite Strict 쿠키로 전달']
  created_at timestamptz [not null]
  last_seen_at timestamptz
  expires_at timestamptz [not null]
  revoked_at timestamptz

  Note: '사용자 계정이 아니라 결과 접근 경계. UUID 만으로 권한을 대신하지 않는다.'
}

Table idempotency_records {
  id uuid [pk]
  anonymous_session_id uuid [not null]
  operation idempotency_operation [not null]
  key_hash bytea [not null, note: '요청 키 원문은 저장하지 않음']
  request_hash bytea [not null, note: '정규화한 요청 본문의 해시']
  analysis_id uuid [not null]
  incident_candidate_id uuid
  fact_revision_id uuid
  created_at timestamptz [not null]
  expires_at timestamptz [not null, note: 'created_at 뒤 24시간 이내 (CHECK)']

  indexes {
    (anonymous_session_id, operation, key_hash) [unique]
  }

  Note: '''
  request_hash 가 같으면 기존 analysis_id 를 반환.
  다르면 409 IDEMPOTENCY_KEY_REUSED.

  CREATE_ANALYSIS 는 analysis_id 만 기록.
  PATCH_FACTS 는 analysis_id · incident_candidate_id · fact_revision_id 를 모두 기록.
  operation 별 반환 자원을 CHECK 로 검사한다.

  Analysis · ANALYZE_VIDEO ProcessingJob · IdempotencyRecord 는 같은 트랜잭션에서 생성.
  '''
}

Table video_assets {
  id uuid [pk]
  anonymous_session_id uuid [not null]
  object_key text [not null, note: '서버가 생성. 클라이언트가 보낸 파일명을 신뢰하지 않음']
  content_sha256 bytea [not null]
  content_type varchar [not null, note: 'magic bytes 와 ffprobe 로 검증한 값']
  size_bytes bigint [not null]
  duration_ms integer
  width integer
  height integer
  status video_asset_status [not null]
  state_version integer [not null]
  validation_error_code varchar
  rights_confirmed_at timestamptz
  created_at timestamptz [not null]
  expires_at timestamptz [note: 'NULL 또는 created_at 뒤 시각 (CHECK)']
  object_deleted_at timestamptz [note: '원본 바이트 삭제 완료 시각. 메타데이터 행의 삭제 시각이 아님']

  Note: '''
  원본 바이트는 Private Object Storage. DB 는 소속·체크섬·삭제 시각만 저장.
  분석이 끝나면 Object Storage 바이트를 먼저 삭제하고 이 메타데이터 행은 연결된 Analysis 의
  24시간 TTL 까지 유지한다. REJECTED 또는 Analysis 가 없는 업로드는 DELETE_VIDEO_ASSET Job 이 정리한다.
  '''
}


// ─────────────────────────────────────────────────────────────
// 경기와 분석
// ─────────────────────────────────────────────────────────────

Table matches {
  id uuid [pk]
  competition varchar [not null]
  season varchar [not null]
  match_date date [not null, note: 'applied_rule_version_id 를 확정하는 기준']
  home_club_id uuid
  away_club_id uuid
  score_home smallint
  score_away smallint
}

Table analyses {
  id uuid [pk]
  anonymous_session_id uuid [note: 'TEMPORARY 면 필수 (CHECK)']
  match_id uuid
  video_asset_id uuid [note: 'TEMPORARY 면 필수. 업로드 한 건은 Analysis 한 건만 생성']
  status varchar [not null]
  retention_class retention_class [not null]
  source_url text [note: '선택적 출처 메타데이터. 영상 취득 수단이 아님']
  source_platform varchar [note: '선택적 출처 메타데이터']
  source_fingerprint bytea [note: 'video_asset_id 와 함께 분석한 입력을 식별']
  applied_rule_version_id uuid [note: 'match_date 기준으로 분석 시작 시 확정']
  pipeline_version varchar
  media_policy_version varchar
  state_version integer [not null]
  failure_code varchar
  created_at timestamptz [not null]
  completed_at timestamptz
  expires_at timestamptz [note: 'TEMPORARY 면 필수 · created_at 뒤 24시간 이내 (CHECK)']

  indexes {
    video_asset_id [unique]
  }

  Note: '''
  하나의 업로드 영상 전체를 처리하는 Aggregate.
  anonymous_session_id 는 이력이 아니라 다른 세션의 결과 조회를 막는 소유 경계.
  모든 조회·취소·삭제는 analysis_id 와 현재 세션을 함께 검사.

  CHECK: TEMPORARY 는 anonymous_session_id · video_asset_id · expires_at 필수
  CHECK: CURATED 는 별도 출처 정보 필수

  PURGE_ANALYSIS 는 증거 객체를 모두 지운 뒤 child 행과 Analysis 를 삭제하고,
  연결된 video_assets 메타데이터 행을 마지막에 삭제한다. 분석 TTL 동안 FK 는 RESTRICT 로 유지한다.
  '''
}

Table processing_jobs {
  id uuid [pk]
  analysis_id uuid [note: 'nullable FK']
  video_asset_id uuid [note: 'nullable FK']
  job_type job_type [not null]
  status job_status [not null]
  payload_version integer [not null]
  job_revision integer [not null, note: '선점할 때마다 올림']
  attempt smallint [not null]
  max_attempts smallint [not null]
  lease_owner varchar
  lease_token_hash bytea
  lease_until timestamptz
  next_attempt_at timestamptz
  failure_code varchar
  retryable boolean
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (analysis_id, job_type, payload_version) [unique]
    (video_asset_id, job_type, payload_version) [unique]
  }

  Note: '''
  MVP 의 PostgreSQL 작업 큐. ClaimProcessingJob 이 FOR UPDATE SKIP LOCKED 로 한 행 선점.
  CHECK: 두 대상이 동시에 있거나 필요한 대상이 없으면 거부.
  Lease 가 만료된 PROCESSING 작업은 다른 Worker 가 재선점 가능.
  결과 보고는 같은 job_revision 과 lease_token 을 가진 Worker 하나만 승인.
  '''
}


// ─────────────────────────────────────────────────────────────
// 사건 후보 · 샷 · 사실
// ─────────────────────────────────────────────────────────────

Table incident_candidates {
  id uuid [pk]
  analysis_id uuid [not null]
  candidate_index integer [not null]
  review_scenario review_scenario [not null, note: '중계에서 관측한 판정 상황. VAR 범주 게이트의 입력이지 범주 자체가 아님']
  start_ms integer [not null]
  end_ms integer [not null]
  broadcast_clock varchar
  detection_confidence real [note: '장면 후보 탐지 신뢰도 — 세 신뢰도 중 하나']
  camera_sufficiency camera_sufficiency [not null, note: '각도 게이트. LOW 면 판정 대신 INCONCLUSIVE']
  current_fact_revision_id uuid
  review_status candidate_review_status [not null]
  created_at timestamptz [not null]

  indexes {
    (analysis_id, candidate_index) [unique]
    (id, analysis_id) [unique]
  }

  Note: '''
  전체 영상에서 찾은 판정 확인 후보. 낮은 탐지 신뢰도도 행을 만들고 화면에 표시한다.
  review_scenario → var_category 매핑은 판본 데이터에 있다.
  SECOND_CAUTION 이 2025/26 에서는 어느 범주에도 닿지 않고
  2026/27 에서는 RED_CARD 에 닿는 것이 그 매핑의 전부다. 코드에 두면 판본 교체가 코드 수정이 된다.
  '''
}

Table shots {
  id uuid [pk]
  analysis_id uuid [not null]
  shot_index integer [not null]
  start_ms integer [not null]
  end_ms integer [not null]
  playback_speed playback_speed [not null, note: 'observed_at_speed 의 근거. 속도 게이트가 이 값을 읽는다']
  is_replay boolean [not null]
  camera_angle_label varchar

  indexes {
    (analysis_id, shot_index) [unique]
    (id, analysis_id) [unique]
  }

  Note: '샷 분할 결과. fact_revision_shots 가 사실값과 이 표를 연결한다.'
}

Table fact_revisions {
  id uuid [pk]
  analysis_id uuid [not null, note: '같은 분석의 Candidate 와 Shot 만 연결하도록 하는 무결성 키']
  incident_candidate_id uuid [not null]
  revision integer [not null]
  facts jsonb [not null, note: 'contact_type 별 JSON Schema 적용. 범주·문턱·절차 게이트가 읽는 값이 여기 함께 들어간다']
  fact_schema_version integer [not null]
  source fact_source [not null]
  extraction_confidence real [note: '사실 추출 신뢰도 — 세 신뢰도 중 하나']
  model_version varchar
  created_at timestamptz [not null]

  indexes {
    (incident_candidate_id, revision) [unique]
    (id, analysis_id) [unique]
    (id, incident_candidate_id, analysis_id) [unique]
  }

  Note: '''
  관찰 사실은 덮어쓰지 않고 Revision 으로 저장.
  PostgreSQL BEFORE UPDATE Trigger 가 UPDATE 를 거부하고 TTL Cleanup 의 DELETE 만 허용.
  현재 Revision 은 incident_candidates.current_fact_revision_id 가 가리킨다.

  facts JSONB 안의 게이트 입력
    disallow_reason        (열거형 disallow_reason)
    referee_decision_type  (열거형 referee_decision_type)
    decision_nature        (열거형 decision_nature)   ← 절차 게이트만 읽는다
    error_magnitude        (열거형 error_magnitude)
    contact_type           (열거형 contact_type)
    observed_at_speed      (열거형 playback_speed)

  Shot 참조는 facts JSONB 배열이 아니라 fact_revision_shots 로 저장.
  Adapter 가 DB 행을 Rule Engine 입력의 Observed.shotIds 배열로 복원한다.

  decision_nature 는 error_magnitude 에 영향을 주지 않는다.
  두 값이 서로를 읽으면 게이트 분리가 무너진다.
  '''
}

Table fact_revision_shots {
  fact_revision_id uuid [pk]
  shot_id uuid [pk]
  analysis_id uuid [not null]

  Note: '''
  Rule Engine 의 Observed.shotIds 를 저장하는 연결 표.
  analysis_id 를 함께 두고 fact_revision 과 shot 이 같은 Analysis 에 속하는지 복합 FK 로 검증한다.
  JSONB 안의 문자열 배열만으로는 삭제와 재처리 때 참조 무결성을 보장할 수 없다.
  '''
}

Table evidence_assets {
  id uuid [pk]
  analysis_id uuid [not null]
  incident_candidate_id uuid
  kind evidence_kind [not null]
  object_key text [not null, note: 'Object Key 와 Storage 읽기 URL 은 브라우저 응답에 포함하지 않음']
  content_sha256 bytea [not null]
  start_ms integer
  end_ms integer
  width integer
  height integer
  created_at timestamptz [not null]
  expires_at timestamptz
  object_deleted_at timestamptz [note: '증거 바이트 삭제 완료 시각. 행은 PURGE_ANALYSIS 가 삭제']

  indexes {
    (id, analysis_id) [unique]
  }

  Note: '''
  같은 익명 세션을 확인하는 Next.js 미디어 프록시로만 재생.
  삭제 완료 전에도 만료된 미디어의 프록시 응답은 차단.
  응답 헤더: Cache-Control private, no-store · X-Robots-Tag noindex, nofollow, noarchive
  '''
}


// ─────────────────────────────────────────────────────────────
// 규정
// ─────────────────────────────────────────────────────────────

Table rules {
  id uuid [pk]
  authority varchar [not null, note: '규정 발행 주체 (IFAB · KFA · KLEAGUE). official_verdicts.announced_by 와 역할이 다르다']
  edition varchar [not null]
  law varchar [not null]
  section varchar [not null]
  concept varchar [not null]
  revision integer [not null]
  content_sha256 bytea [not null]
  original_text text [note: '조항 단위. 규정 원문 전문은 저장하지 않는다']
  official_korean text [note: 'KFA 대조판 확보 전까지 비워 둔다']
  plain_korean text
  source_page varchar
  source_url text
  review_status varchar [not null, note: 'official_korean 이 비었는지를 이 값으로 구분']

  Note: '발행된 행은 수정하지 않는다. 교정이 필요하면 새 revision 을 만든다.'
}

Table competition_rule_versions {
  id uuid [pk]
  competition varchar [not null]
  season varchar [not null]
  effective_from date [not null]
  effective_to date
  ifab_edition varchar [not null]
  source_document text
  verification_status varchar [not null, note: 'README 3절 기준 현재 INFERRED. CONFIRMED 로 올릴 수 있는지는 15절에서 열린 항목']

  Note: '대회 → IFAB 판본 매핑. 1단계에서는 코드로 굳히지 않고 호출자가 판본 id 를 직접 준다.'
}


// ─────────────────────────────────────────────────────────────
// 판정 결과 — 이 표의 행은 한 번 쓰면 고치지 않는다
// ─────────────────────────────────────────────────────────────

Table decision_results {
  id uuid [pk]
  analysis_id uuid [not null]
  incident_candidate_id uuid [not null]
  fact_revision_id uuid [not null]
  applied_rule_version_id uuid [not null]

  // 관측 판정 — 영상에서 실제로 무슨 판정이 내려졌는가
  observed_restart_type observed_restart_type [not null]
  observed_restart_beneficiary observed_restart_beneficiary [not null]
  observed_card disciplinary_action [note: '[결정] disciplinary_action 어휘를 공유']
  observed_goal_decision observed_goal_decision [not null]
  observed_source observed_source [not null]

  // 추천 판정 — 규정을 적용하면 무엇이 나오는가
  //
  // [결정] 관측 열과 같은 어휘를 쓴다. 같은 축에 두 벌을 두면 decision_match
  //        비교가 값 변환을 먼저 해야 하고, 그 변환표가 두 어휘가 어긋날 수 있는
  //        자리가 된다. 엔진은 어휘의 부분집합만 낸다 — UNKNOWN 은 관측 전용이고,
  //        SECOND_CAUTION 은 이 사건 하나로 알 수 없으므로 관측에서만 들어온다.
  foul_decision foul_decision
  severity severity
  goal_decision observed_goal_decision
  restart_type observed_restart_type [note: 'PLAY_CONTINUED 가 "재개 없음"이다. NONE 을 따로 두지 않는다']
  disciplinary_action disciplinary_action

  // 비교
  decision_match decision_match [not null, note: 'MISMATCH 를 오심 확정값으로 쓰지 않는다']

  // VAR 네 게이트 — 합치지 않는다
  var_reviewable boolean [not null, note: '1 범주']
  var_category var_category [not null, note: '1 범주']
  var_within_time_window boolean [not null, note: '2 시한']
  var_threshold_met var_threshold_result [not null, note: '3 문턱']
  var_intervention var_intervention [not null]
  var_no_intervention_reason var_no_intervention_reason [note: '어느 게이트가 막았는가']
  var_not_reviewable_reason var_not_reviewable_reason [note: '범주 게이트가 왜 막았는가']
  var_window_closed_reason var_window_closed_reason [note: '시한 게이트가 왜 막았는가']
  var_window_exception var_window_exception [not null, note: 'NONE 이 아니면 재개 여부와 무관하게 var_within_time_window 가 참']
  var_review_procedure var_review_procedure [not null, note: '4 절차. 문턱과 무관하다']

  // 한계와 재현
  judgment_confidence_level varchar [not null, note: '규정 적용 결론 신뢰도 — 세 신뢰도 중 하나']
  inconclusive_reason inconclusive_reason
  fact_signature bytea [not null, note: '판정에 사용된 사실값의 정규화 해시. 경기·심판 식별자를 포함하지 않는다']
  rule_engine_version varchar [not null]
  evaluation_schema_version integer [not null]
  evaluation_snapshot jsonb [not null, note: 'accounts · conflicts · narrowedTo · blockedFrom · varAssessment · 판정값 전체']

  // 근거
  citations jsonb [not null, note: 'RuleCitation[] · 최소 1개 (CHECK jsonb_array_length >= 1)']
  cited_laws "text[]" [note: 'citations 에서 생성한 GENERATED ALWAYS AS (...) STORED 열. Law 별 조회 인덱스']
  created_at timestamptz [not null, note: '갱신 시각은 두지 않는다']

  indexes {
    (incident_candidate_id, fact_revision_id, applied_rule_version_id, rule_engine_version) [unique]
    (id, analysis_id) [unique]
    (fact_signature, applied_rule_version_id, rule_engine_version) [name: 'idx_signature_cache']
    cited_laws [type: gin]
  }

  Note: '''
  한 번 쓰면 고치지 않는다. PostgreSQL BEFORE UPDATE Trigger 가 UPDATE 를 거부.
  사실값이 바뀌면 새 fact_revisions 행과 새 decision_results 행을 만든다.
  덮어쓰면 규정 판본과 엔진 버전이 사라진 입력을 가리켜 재현성을 잃는다.

  평면 열은 조회와 인덱스에, evaluation_snapshot 은 과거 엔진을 다시 실행하지 않고
  결과 화면을 재구성하는 데 쓴다.

  (fact_signature, applied_rule_version_id, rule_engine_version) 은
  다른 사건의 같은 사실 조합을 찾는 캐시 키로만 쓴다.

  네 게이트를 하나로 접지 않는다:
    var_reviewable = true 와 var_intervention = NO_INTERVENTION 이 동시에 표현되어야 한다.
    NOT_REVIEWABLE 과 THRESHOLD_NOT_MET 은 결과가 같아도 의미가 전혀 다르다.

  (fact_revision_id, incident_candidate_id, analysis_id) 는 fact_revisions 의 복합 키를 참조한다.
  다른 후보나 다른 분석의 Fact Revision 으로 결과를 만드는 저장을 DB 에서 거부한다.
  '''
}

Table official_verdicts {
  id uuid [pk]
  analysis_id uuid [not null]
  incident_candidate_id uuid [not null]
  announced_by announced_by [not null, note: '사건 판단 발표 주체. rules.authority 와 역할이 다르다']
  announced_by_name varchar [note: '발표문에 적힌 기관명']
  announced_on date
  verdict official_verdict_value [not null]
  quote text [note: '심판 개인 식별 정보는 여기에도 넣지 않는다. 발표문에 이름이 있으면 제거하고 저장']
  source_url text
  status official_verdict_status [not null]

  indexes {
    (id, analysis_id) [unique]
  }

  Note: '''
  외부 기관의 판단. 시스템 판정과 별도로 표시하고 어느 쪽도 자동으로 정답 처리하지 않는다.
  공식 발표가 없는 사건은 행을 만들지 않는다.
  (incident_candidate_id, analysis_id) 는 incident_candidates 의 복합 키를 참조한다.
  '''
}


// ─────────────────────────────────────────────────────────────
// 구단 — MVP 경기 선택과 결과 표시에 필요한 최소 열만 둠
// ─────────────────────────────────────────────────────────────

Table clubs {
  id uuid [pk]
  canonical_name text [not null]
  short_code varchar [not null, unique, note: 'MVP 화면의 약칭 배지. 예 SUW']
  created_at timestamptz [not null]

  Note: '공식 엠블럼과 구단명 이력과 시즌별 소속은 MVP 밖. 별도 확장 마이그레이션에서 추가한다.'
}


// ─────────────────────────────────────────────────────────────
// 관계
// ─────────────────────────────────────────────────────────────

Ref: idempotency_records.anonymous_session_id > anonymous_sessions.id
Ref: idempotency_records.analysis_id > analyses.id
Ref: idempotency_records.(fact_revision_id, incident_candidate_id, analysis_id) > fact_revisions.(id, incident_candidate_id, analysis_id)
Ref: video_assets.anonymous_session_id > anonymous_sessions.id

Ref: analyses.anonymous_session_id > anonymous_sessions.id
Ref: analyses.match_id > matches.id
Ref: analyses.video_asset_id > video_assets.id
Ref: analyses.applied_rule_version_id > competition_rule_versions.id

Ref: processing_jobs.analysis_id > analyses.id
Ref: processing_jobs.video_asset_id > video_assets.id

Ref: incident_candidates.analysis_id > analyses.id
Ref: incident_candidates.(current_fact_revision_id, id, analysis_id) - fact_revisions.(id, incident_candidate_id, analysis_id)
Ref: shots.analysis_id > analyses.id
Ref: fact_revisions.(incident_candidate_id, analysis_id) > incident_candidates.(id, analysis_id)
Ref: fact_revision_shots.(fact_revision_id, analysis_id) > fact_revisions.(id, analysis_id)
Ref: fact_revision_shots.(shot_id, analysis_id) > shots.(id, analysis_id)

Ref: evidence_assets.analysis_id > analyses.id
Ref: evidence_assets.(incident_candidate_id, analysis_id) > incident_candidates.(id, analysis_id)

Ref: decision_results.analysis_id > analyses.id
Ref: decision_results.(incident_candidate_id, analysis_id) > incident_candidates.(id, analysis_id)
Ref: decision_results.(fact_revision_id, incident_candidate_id, analysis_id) > fact_revisions.(id, incident_candidate_id, analysis_id)
Ref: decision_results.applied_rule_version_id > competition_rule_versions.id

Ref: official_verdicts.analysis_id > analyses.id
Ref: official_verdicts.(incident_candidate_id, analysis_id) > incident_candidates.(id, analysis_id)

Ref: matches.home_club_id > clubs.id
Ref: matches.away_club_id > clubs.id
